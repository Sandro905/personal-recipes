  "steps": [
    {
      "title": {
        "it": "Marinare il manzo"
      },
      "text": {
        "it": "Taglia {{fesa-manzo}} a fettine sottili e uniscile a {{salsa-soia-poco-sale}}, {{dolcificante-stevia-eritritolo}}, pepe nero e zenzero in polvere. Mescola e lascia marinare circa 30 minuti."
      },
      "timer": 1800
    },
    {
      "title": {
        "it": "Preparare la salsa"
      },
      "text": {
        "it": "Nel frattempo mescola in una ciotolina {{salsa-soia-poco-sale#2}}, {{salsa-teriyaki-zero}}, {{mirin}} e una macinata di pepe nero."
      }
    },
    {
      "title": {
        "it": "Preparare gli udon"
      },
      "text": {
        "it": "Prepara {{udon-precotti}} seguendo le indicazioni della confezione: se sono già precotti, separali e ammorbidiscili."
      }
    },
    {
      "title": {
        "it": "Rosolare il manzo"
      },
      "text": {
        "it": "Scalda una padella larga o un wok con {{olio-oliva-evo}} e rosola il manzo a fiamma alta. Mettilo da parte."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Ammorbidire la cipolla"
      },
      "text": {
        "it": "Nella stessa padella unisci {{cipolla}}, tagliata a fette, con un filo d'acqua e lasciala ammorbidire."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Aglio e zenzero"
      },
      "text": {
        "it": "Aggiungi {{aglio}} e {{zenzero-polvere#2}} e salta qualche minuto."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Le verdure"
      },
      "text": {
        "it": "Unisci {{funghi-champignon}}, {{pak-choi}} e {{cipollotto}} e cuoci finché le verdure risultano tenere."
      }
    },
    {
      "title": {
        "it": "Saltare tutto insieme"
      },
      "text": {
        "it": "Rimetti il manzo in padella, aggiungi gli udon e versa tutta la salsa. Salta a fiamma alta per 2-3 minuti mescolando bene, fino a ottenere udon completamente ricoperti da una salsa lucida e saporita."
      },
      "timer": 150
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Tagliare il manzo"
      },
      "text": {
        "it": "Il taglio sottile è la parte che conta: se la carne è difficile da affettare, tienila 20 minuti in freezer prima. Taglia sempre contro le fibre, così resta tenera anche a fiamma alta."
      }
    },
    {
      "title": {
        "it": "La padella"
      },
      "text": {
        "it": "Con 400 g di manzo conviene rosolare a due volte: la carne ammassata rilascia liquido e bolle invece di rosolare. La padella deve essere ben calda prima di metterla."
      }
    },
    {
      "title": {
        "it": "Conservazione"
      },
      "text": {
        "it": "Si conserva 2 giorni in frigo in un contenitore chiuso. Per scaldarlo, salta gli udon in padella con un cucchiaio d'acqua: nel microonde tendono a stringersi."
      }
    }
  ]
}
