  "steps": [
    {
      "title": {
        "it": "I gamberetti"
      },
      "text": {
        "it": "Scalda {{olio-oliva-evo}} con {{aglio}}, rosola {{gamberi}} per 2 minuti scarsi e mettili subito da parte. Cotti adesso fino in fondo, alla fine sarebbero gomma."
      },
      "timer": 120
    },
    {
      "title": {
        "it": "Tostare"
      },
      "text": {
        "it": "Nella stessa padella tosta {{riso-carnaroli}} per un minuto, poi sfuma con {{vino-bianco}} e lascia evaporare."
      },
      "timer": 60
    },
    {
      "title": {
        "it": "Cottura"
      },
      "text": {
        "it": "Aggiungi {{brodo-vegetale}} un mestolo alla volta, mescolando spesso, per 18-20 minuti. Il riso deve restare sempre appena coperto, mai in ammollo."
      },
      "timer": 1200
    },
    {
      "title": {
        "it": "Mantecare"
      },
      "text": {
        "it": "A fuoco spento unisci i gamberetti, la scorza e il succo di {{limone}}, {{prezzemolo}} e una macinata di pepe. Mescola energicamente 30 secondi."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Niente burro né parmigiano"
      },
      "text": {
        "it": "La mantecatura viene dall'amido: mescolare bene negli ultimi minuti fa più della materia grassa. Così il piatto resta sotto i 15 g di grassi."
      }
    },
    {
      "title": {
        "it": "La scorza"
      },
      "text": {
        "it": "Grattugia solo la parte gialla. Il bianco sotto è amaro e rovina il piatto."
      }
    }
  ]
}
