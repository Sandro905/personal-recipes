  "steps": [
    {
      "title": {
        "it": "Patate in forno"
      },
      "text": {
        "it": "Taglia {{patate}} a spicchi, condisci con sale e pepe e inforna a 200 °C per 30-35 minuti."
      },
      "timer": 2000
    },
    {
      "title": {
        "it": "Rosolare il pollo"
      },
      "text": {
        "it": "Scalda {{olio-oliva-evo}} e rosola {{petto-pollo}} 3 minuti per lato, giusto per colorirlo. Non deve cuocere fino in fondo adesso."
      }
    },
    {
      "title": {
        "it": "Il sugo"
      },
      "text": {
        "it": "Aggiungi {{cipolla}} e {{aglio}} tritati, poi {{pomodori-pelati}}, {{olive-nere}}, {{origano}} e {{alloro}}."
      }
    },
    {
      "title": {
        "it": "Cottura coperta"
      },
      "text": {
        "it": "Copri e cuoci a fuoco medio-basso 25-30 minuti. Il pollo finisce di cuocere nel sugo e resta morbido invece di asciugarsi."
      },
      "timer": 1800
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Perché coperto"
      },
      "text": {
        "it": "Il petto di pollo è magrissimo e in padella scoperta diventa stopposo in pochi minuti. Nel sugo coperto resta tenero anche dopo mezz'ora."
      }
    },
    {
      "title": {
        "it": "Il giorno dopo"
      },
      "text": {
        "it": "È una di quelle cose che migliorano riscaldate. Si conserva 2 giorni in frigo in contenitore ermetico."
      }
    }
  ]
