  "steps": [
    {
      "title": {
        "it": "Cipolla"
      },
      "text": {
        "it": "Fai appassire {{cipolla}} tritata in {{olio-oliva-evo}} per 3 minuti."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Il pollo"
      },
      "text": {
        "it": "Aggiungi {{petto-pollo}} a pezzetti e fallo colorire a fuoco vivo. Non muoverlo troppo: deve prendere colore, non lessarsi."
      }
    },
    {
      "title": {
        "it": "Peperone"
      },
      "text": {
        "it": "Unisci {{peperone}} a cubetti e {{paprika-dolce}}, cuoci 3 minuti."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Tostare il riso"
      },
      "text": {
        "it": "Aggiungi {{riso-bianco}} e tostalo un minuto mescolando, finché i chicchi diventano lucidi."
      },
      "timer": 60
    },
    {
      "title": {
        "it": "Cottura"
      },
      "text": {
        "it": "Unisci {{pomodori-pelati}} e poi {{brodo-vegetale}} un mestolo alla volta, mescolando come un risotto, per 18-20 minuti. Aggiusta di sale e pepe."
      },
      "timer": 1200
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Il brodo caldo"
      },
      "text": {
        "it": "Tienilo caldo in un pentolino a fianco: aggiunto freddo blocca la cottura ogni volta e il riso viene irregolare."
      }
    },
    {
      "title": {
        "it": "Più cremoso"
      },
      "text": {
        "it": "Se lo vuoi più legato, negli ultimi 2 minuti mescola energicamente: l'amido del riso fa il resto senza bisogno di burro."
      }
    }
  ]
