  "steps": [
    {
      "title": {
        "it": "Rosolare la carne"
      },
      "text": {
        "it": "Asciuga bene {{manzo-spezzatino}} con carta da cucina e rosolalo in {{olio-oliva-evo}} a fuoco molto vivo, in 2-3 riprese. Mettilo da parte."
      }
    },
    {
      "title": {
        "it": "Il soffritto"
      },
      "text": {
        "it": "Nella stessa pentola fai appassire {{cipolla}}, {{sedano}}, {{carota}} e {{aglio}} per 5-6 minuti, raccogliendo il fondo di cottura."
      },
      "timer": 360
    },
    {
      "title": {
        "it": "Sfumare"
      },
      "text": {
        "it": "Rimetti la carne e sfuma con {{vino-rosso}}, lasciando evaporare l'alcol."
      },
      "timer": 180
    },
    {
      "title": {
        "it": "Cottura lunga"
      },
      "text": {
        "it": "Aggiungi {{passata-pomodoro}}, {{brodo-vegetale}}, {{alloro}} e {{rosmarino}}. Copri e cuoci a fuoco **bassissimo** per 90 minuti: deve appena sobbollire."
      },
      "timer": 5400
    },
    {
      "title": {
        "it": "Le patate"
      },
      "text": {
        "it": "Unisci {{patate}} a cubetti e cuoci altri 25-30 minuti, finché sono tenere ma ancora intere."
      },
      "timer": 1800
    },
    {
      "title": {
        "it": "Congelare"
      },
      "text": {
        "it": "Raffredda completamente, dividi in 4 contenitori ermetici e congela."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Asciugare la carne"
      },
      "text": {
        "it": "È il passaggio che fa la differenza: la carne bagnata non rosola, bolle. Carta da cucina e padella rovente."
      }
    },
    {
      "title": {
        "it": "Completare il pasto"
      },
      "text": {
        "it": "Con ~510 kcal a porzione resta sotto il target del pranzo: aggiungi **una fetta di pane** per arrivarci."
      }
    },
    {
      "title": {
        "it": "Conservazione"
      },
      "text": {
        "it": "Fino a **2-3 mesi** in freezer. Dal freezer diretto al microonde: 5-6 minuti a potenza media con un cucchiaio d'acqua."
      }
    }
  ]
