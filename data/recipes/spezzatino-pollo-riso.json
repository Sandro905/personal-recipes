  "steps": [
    {
      "title": {
        "it": "Rosolare il pollo"
      },
      "text": {
        "it": "Rosola {{petto-pollo}} in {{olio-oliva-evo}} a fuoco vivo in 2 riprese, giusto per colorirlo. Mettilo da parte."
      }
    },
    {
      "title": {
        "it": "Le verdure"
      },
      "text": {
        "it": "Soffriggi {{cipolla}}, {{aglio}} e {{peperone}} con {{paprika-affumicata}} e {{paprika-dolce}} per 7-8 minuti."
      },
      "timer": 480
    },
    {
      "title": {
        "it": "Cottura"
      },
      "text": {
        "it": "Rimetti il pollo, aggiungi {{pomodori-pelati}} e {{brodo-vegetale}}, sale e pepe. Copri e cuoci 25-30 minuti."
      },
      "timer": 1800
    },
    {
      "title": {
        "it": "Il riso"
      },
      "text": {
        "it": "Cuoci {{riso-bianco}} al dente, **due minuti in meno** del solito: finirà di cuocere quando lo riscaldi."
      }
    },
    {
      "title": {
        "it": "Comporre le vaschette"
      },
      "text": {
        "it": "In ogni contenitore: riso sul fondo, spezzatino sopra. **Non mescolare** — il riso resta asciutto e non diventa una pappa. Raffredda e congela."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Riscaldare"
      },
      "text": {
        "it": "Microonde 4-5 minuti a potenza media con un cucchiaio d'acqua, mescolando a metà."
      }
    },
    {
      "title": {
        "it": "Perché non mescolare"
      },
      "text": {
        "it": "Il riso a contatto col sugo per settimane in freezer assorbe liquido e si spappola. Tenendoli separati nella stessa vaschetta si mescolano solo al momento di mangiare."
      }
    }
  ]
