  "steps": [
    {
      "title": {
        "it": "La cipolla"
      },
      "text": {
        "it": "Fai appassire {{cipolla}} tritata fine in {{olio-oliva-evo}} per 4-5 minuti a fuoco dolce, senza farle prendere colore."
      },
      "timer": 300
    },
    {
      "title": {
        "it": "Sfumare"
      },
      "text": {
        "it": "Sfuma con {{vino-bianco}} e lascia evaporare."
      },
      "timer": 60
    },
    {
      "title": {
        "it": "La crema"
      },
      "text": {
        "it": "Abbassa la fiamma, aggiungi {{philadelphia-light}} e mescola con un po' di acqua di cottura fino a una crema liscia."
      }
    },
    {
      "title": {
        "it": "Il salmone"
      },
      "text": {
        "it": "Spegni il fuoco e solo adesso unisci {{salmone-affumicato}}: è già pronto da mangiare, se lo cuoci si indurisce e perde il profumo."
      }
    },
    {
      "title": {
        "it": "Mantecare"
      },
      "text": {
        "it": "Manteca con {{pasta-secca}} al dente e acqua di cottura. Completa con {{erba-cipollina}} e pepe nero abbondante."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Niente sale"
      },
      "text": {
        "it": "Il salmone affumicato è già molto sapido: assaggia prima di aggiungere sale, probabilmente non serve."
      }
    },
    {
      "title": {
        "it": "Piatto sostanzioso"
      },
      "text": {
        "it": "Fra salmone, formaggio e olio è un piatto ricco: se vuoi alleggerirlo, i 10 g di olio si possono togliere del tutto, la cremosità la fa il formaggio spalmabile."
      }
    }
  ]
}
