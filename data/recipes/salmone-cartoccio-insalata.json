  "steps": [
    {
      "title": {
        "it": "Il cartoccio"
      },
      "text": {
        "it": "Metti {{salmone}} su un foglio di carta forno con {{limone}} a fette, {{rosmarino}}, sale e pepe. Chiudi il cartoccio lasciando un po' d'aria dentro."
      }
    },
    {
      "title": {
        "it": "In forno"
      },
      "text": {
        "it": "18 minuti a 200 °C. Il vapore che si forma dentro lo tiene umido: è quasi impossibile asciugarlo."
      },
      "timer": 1080
    },
    {
      "title": {
        "it": "Servire"
      },
      "text": {
        "it": "Apri il cartoccio a tavola e accompagna con {{insalata}} condita con {{olio-oliva-evo}}."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Giorni di riposo"
      },
      "text": {
        "it": "Con 4 g di carboidrati è pensata per le sere in cui non ti alleni e i carboidrati della giornata sono già a target."
      }
    },
    {
      "title": {
        "it": "Niente da lavare"
      },
      "text": {
        "it": "Il cartoccio si butta: resta solo il piatto. È il motivo principale per cui questa cena si fa davvero."
