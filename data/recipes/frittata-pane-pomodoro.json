  "steps": [
    {
      "title": {
        "it": "Sbattere"
      },
      "text": {
        "it": "Sbatti {{uova}} con sale e pepe, senza esagerare: basta che tuorli e albumi siano uniti."
      }
    },
    {
      "title": {
        "it": "In padella"
      },
      "text": {
        "it": "Scalda {{olio-oliva-evo}} in una padella antiaderente a fuoco **basso**, versa le uova e lascia rapprendere 5-6 minuti senza toccare."
      },
      "timer": 360
    },
    {
      "title": {
        "it": "Girare"
      },
      "text": {
        "it": "Quando la superficie è quasi asciutta, gira con l'aiuto di un piatto e cuoci altri 2 minuti."
      },
      "timer": 120
    },
    {
      "title": {
        "it": "Servire"
      },
      "text": {
        "it": "Accompagna con {{pane-integrale}} e {{pomodoro}} a fette."
      }
    }
