  "steps": [
    {
      "title": {
        "it": "Rosolare il pesce"
      },
      "text": {
        "it": "Scalda {{olio-oliva-evo}} con {{aglio}} e rosola {{pesce-spada}} a cubetti 2 minuti per lato a fuoco vivo. Deve prendere colore fuori e restare appena rosato dentro."
      },
      "timer": 120
    },
    {
      "title": {
        "it": "Sfumare"
      },
      "text": {
        "it": "Sfuma con {{vino-bianco}} e lascia evaporare."
      },
      "timer": 60
    },
    {
      "title": {
        "it": "Il sugo"
      },
      "text": {
        "it": "Aggiungi {{pomodorini}} tagliati a metà e {{olive-nere}}, cuoci 4-5 minuti."
      },
      "timer": 280
    },
    {
      "title": {
        "it": "Mantecare"
      },
      "text": {
        "it": "Salta con {{pasta-secca}} al dente e un po' di acqua di cottura, finisci con {{prezzemolo}}."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Con il merluzzo"
      },
      "text": {
        "it": "Sostituisci con **180 g di merluzzo** surgelato scongelato e asciugato: scendi a circa 600 kcal mantenendo 46 g di proteine."
      }
    },
    {
      "title": {
        "it": "Non stracuocere"
      },
      "text": {
        "it": "Il pesce a cubetti cuoce in pochissimo. Se lo lasci nel sugo tutto il tempo diventa asciutto: meglio toglierlo e rimetterlo alla fine."
