  "steps": [
    {
      "title": {
        "it": "Scaldare"
      },
      "text": {
        "it": "Passa {{tortilla}} 20 secondi per lato in padella asciutta: diventa morbida e non si spacca quando la arrotoli."
      }
    },
    {
      "title": {
        "it": "Farcire"
      },
      "text": {
        "it": "Scalda {{petto-pollo-cotto}} e condiscilo con {{paprika-dolce}}, sale e pepe. Disponilo al centro della tortilla con {{insalata}} e {{salsa-zero}}."
      }
    },
    {
      "title": {
        "it": "Chiudere"
      },
      "text": {
        "it": "Ripiega prima i due lati corti, poi arrotola stretto. Tagliato a metà in diagonale sta in piedi nel piatto."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Con gli straccetti"
      },
      "text": {
        "it": "Va benissimo con una porzione di straccetti di pollo alla paprika presi dal freezer: è il loro abbinamento naturale."
      }
    },
    {
      "title": {
        "it": "Più proteine"
      },
      "text": {
        "it": "Con 30 g di grana grattugiato arrivi a circa 645 kcal e 67 g di proteine."
      }
    }
  ]
