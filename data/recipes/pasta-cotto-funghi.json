  "steps": [
    {
      "title": {
        "it": "I funghi"
      },
      "text": {
        "it": "Affetta {{funghi-champignon}} e mettili in padella con un goccio d'acqua. Cuoci finché hanno perso gran parte della loro acqua."
      },
      "timer": 300
    },
    {
      "title": {
        "it": "Il prosciutto"
      },
      "text": {
        "it": "Unisci {{prosciutto-cotto}} a cubetti e fallo rosolare leggermente."
      },
      "timer": 120
    },
    {
      "title": {
        "it": "La pasta"
      },
      "text": {
        "it": "Cuoci {{pasta-secca}} in acqua salata e scolala al dente, tenendo da parte un mestolo di acqua di cottura."
      }
    },
    {
      "title": {
        "it": "La cremina"
      },
      "text": {
        "it": "Versa la pasta in padella, aggiungi {{olio-oliva-evo}}, {{grana-padano}} e poca acqua di cottura. Mescola a fuoco vivo finché diventa cremosa, poi completa con {{pepe-nero}}."
      }
    }
  ],
  "notes": [
    {
      "title": {
        "it": "Senza panna"
      },
      "text": {
        "it": "L'amido dell'acqua di cottura insieme al grana basta per la cremosità: aggiungila poca alla volta, finché la pasta si lega."
      }
    },
    {
      "title": {
        "it": "Sale"
      },
      "text": {
        "it": "Il prosciutto cotto e il grana sono già sapidi: assaggia prima di aggiungere altro sale."
